      "archive_empty_fence_opening_line": 129,
      "public_source_block_index": 12,
      "current_fence_opening_line": 173,
      "exact_literal_match_current": true,
      "full_source_block_text": "ln -s /flash/rw/container/aa10a963-9715-4c61-967c-7d9f993410e6/root/rev /revlnk",
      "source_text_sha256_recorded": "f1d21e81841dc0036b3e2b6075fcf22bed06a7bc81c89b18afe3d88ec68abf38",
      "source_text_sha256_recomputed_utf8": "f1d21e81841dc0036b3e2b6075fcf22bed06a7bc81c89b18afe3d88ec68abf38",
      "source_text_hash_matches": true,
