      "source_text_sha256_recomputed_utf8": "4e7e2a9f1d7dc03ea43e34322141a6cd8d74ce5701517aa67871a22f82f00ec9",
      "source_text_hash_matches": true,
      "source_cache_sha256_recorded": "5760fee8eba869362aaf0639027b03ff8331338301a5a95e4bb69c2d2f569e5f",
      "source_url_recorded": "https://blog.nns.ee/2022/08/05/routeros-container-rce/",
      "source_author_or_attribution": "Rasmus Moorats (nns)",
      "context_before_exact": "这就是发起成功攻击所需的mount操作。我们可以用msfvenom生成一个攻击payload：  ",
      "context_after_exact": "将它复制到容器中，并创建一个指向其可执行挂载点位置的符号链接：  "
    },
